# Copy to .env.local for development. On the server these live in
# /var/www/heckled.dev-shared/.env.
GRADIUM_API_KEY=
ANTHROPIC_API_KEY=
# Hashes visitor IPs for rate limiting. Any long random string.
HECKLED_SECRET=
SITE_URL=http://localhost:3015

# Production only:
# PORT=3015
# DATA_DIR=/var/www/heckled.dev-shared/data
# CHROME_PATH=/usr/bin/google-chrome
# RATE_LIMIT_PER_HOUR=3
# DAILY_HECKLE_CAP=400
# GRADIUM_CREDIT_FLOOR=5000
